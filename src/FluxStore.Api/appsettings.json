{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {}
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "YOUR_SEQ_SERVER_URL"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "YOUR_APPLICATION_NAME"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DATABASE_CONNECTION_STRING"
  },
  "TokenSettings": {
    "SecretKey": "YOUR_SECURE_JWT_SECRET_KEY",
    "Issuer": "YOUR_TOKEN_ISSUER_URL",
    "Audience": "YOUR_TOKEN_AUDIENCE_URL",
    "AccessTokenExpiryInMinutes": 15,
    "RefreshTokenExpiryInMinutes": 1440
  },
  "SmtpSettings": {
    "Name": "YOUR_SENDER_NAME",
    "Server": "YOUR_SMTP_SERVER",
    "Port": 587,
    "User": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "UseSsl": true,
    "RequiresAuthentication": true
  },
  "DatabaseSetupSettings": {
    "ResetOnStartup": false,
    "EnsureCreated": true,
    "SeedInitialData": true
  },
  "CorsSettings": {
    "PolicyName": "AllowSpecificOrigins",
    "AllowedOrigins": [
      "YOUR_FRONTEND_URL_1",
      "YOUR_FRONTEND_URL_2"
    ],
    "AllowCredentials": true
  },
  "ExternalAuthenticationSettings": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "Apple": {
      "ClientId": "YOUR_APPLE_CLIENT_ID",
      "KeyId": "YOUR_APPLE_KEY_ID",
      "TeamId": "YOUR_APPLE_TEAM_ID",
      "PrivateKey": "YOUR_APPLE_PRIVATE_KEY"
    }
  },
  "AllowedHosts": "*"
}